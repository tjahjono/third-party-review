# Copy to .env and adjust. docker compose reads .env from the repository root.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | production
APP_PORT=8080                 # host port the app is published on
LOG_LEVEL=info                # debug | info | warn | error

# Required in production. Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string
SESSION_TTL=12h

MAX_UPLOAD_MB=25              # largest questionnaire accepted
RUN_MIGRATIONS=true           # apply pending migrations on startup

# First account. Leave both blank and the first visit shows a setup screen
# instead. Ignored once any account exists, so a restart cannot reset an
# account or create a second one. Password must be at least 12 characters.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=tpsa
POSTGRES_PASSWORD=tpsa
POSTGRES_DB=tpsa
POSTGRES_PORT=5432

# Only needed when running the app outside compose; inside compose the app
# builds this from the values above.
# DATABASE_URL=postgres://tpsa:tpsa@localhost:5432/tpsa?sslmode=disable

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# openaicompat - any OpenAI-compatible endpoint: Open WebUI, OpenAI, vLLM,
#                Ollama's compat layer, LiteLLM, most internal gateways.
# anthropic    - the Anthropic Messages API.
# mock         - deterministic offline reviewer. No API calls, no cost. Use it
#                to exercise the whole pipeline without a key.
AI_PROVIDER=mock

# --- Open WebUI serving Qwen (the default deployment) ---
# The base URL is the Open WebUI root plus /api. The API key comes from
# Open WebUI: Settings > Account > API keys.
# AI_PROVIDER=openaicompat
# AI_BASE_URL=https://openwebui.internal.example/api
# AI_CHAT_PATH=/chat/completions
# AI_API_KEY=sk-...
# AI_MODEL=qwen2.5:32b-instruct

# --- OpenAI ---
# AI_PROVIDER=openaicompat
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# --- Anthropic ---
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-20250514

AI_MAX_TOKENS=4096            # raise if reviews are truncated mid-batch
AI_TEMPERATURE=0.2            # low: scoring should be repeatable
AI_TIMEOUT=120s
AI_MAX_RETRIES=2
AI_BATCH_SIZE=8               # answers per call. Lower this for a small
                              # context window; raise it for better
                              # cross-answer contradiction detection.
AI_MAX_CONCURRENCY=2          # concurrent background review runs
