# Copy to .env and adjust.
#
# The app loads this file itself on startup, so `go run ./cmd/server` needs
# nothing exported by hand. Exported variables always win over the file, so a
# container's environment is never overridden by a stale .env in the image.
# Point somewhere else with ENV_FILE=/path/to/file.
#
# docker compose does NOT read it automatically from here: it resolves a bare
# .env relative to the compose file's own directory. The Makefile passes
# --env-file .env for that reason; see README. `docker stack deploy` has no
# --env-file flag at all - run it from the repository root and it picks up
# this file from the current directory on its own.
#
# CREDENTIALS ARE NOT HERE. Under Docker (compose or stack deploy),
# SESSION_SECRET, the Postgres password, AI_API_KEY and BOOTSTRAP_PASSWORD
# come from Docker secrets instead - see secrets/README.md, and run
# `make secrets` to create them. This file only has to carry those four for
# a non-Docker run (`go run ./cmd/server` / `make run`), where they're
# listed below as plain variables for convenience; every one of them also
# accepts a FOO_FILE variant (e.g. SESSION_SECRET_FILE=/path/to/file) if you
# would rather point at a file there too.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development           # development | production
APP_PORT=8080                 # host port the app is published on
LOG_LEVEL=info                # debug | info | warn | error

# Non-Docker runs only - see the note above. Required in production either
# way. Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string
SESSION_TTL=12h

MAX_UPLOAD_MB=25              # largest questionnaire accepted
RUN_MIGRATIONS=true           # apply pending migrations on startup

# First account. Leave both blank and the first visit shows a setup screen
# instead. Ignored once any account exists, so a restart cannot reset an
# account or create a second one. Password must be at least 12 characters.
# BOOTSTRAP_PASSWORD is non-Docker only - see the note above.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# POSTGRES_USER/DB/PORT are used everywhere (Docker and not). POSTGRES_HOST
# defaults to localhost, which is right for a non-Docker run against a local
# Postgres; docker-compose.yml overrides it to the "postgres" service name.
# POSTGRES_PASSWORD is non-Docker only - see the note above.
POSTGRES_USER=tpsa
POSTGRES_PASSWORD=tpsa
POSTGRES_DB=tpsa
POSTGRES_PORT=5432
# POSTGRES_HOST=localhost

# The app builds its connection string from the POSTGRES_* values above.
# Set DATABASE_URL instead - a full connection string wins outright - only
# if you're pointing at a managed Postgres that hands you one ready-made.
# DATABASE_URL=postgres://tpsa:tpsa@localhost:5432/tpsa?sslmode=disable

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# openaicompat - any OpenAI-compatible endpoint: Open WebUI, OpenAI, vLLM,
#                Ollama's compat layer, LiteLLM, most internal gateways.
# anthropic    - the Anthropic Messages API.
# mock         - deterministic offline reviewer. No API calls, no cost. Use it
#                to exercise the whole pipeline without a key.
AI_PROVIDER=mock

# AI_API_KEY is non-Docker only - see the note at the top of this file. Under
# Docker it comes from secrets/ai_api_key.txt regardless of provider.

# --- Open WebUI serving Qwen (the default deployment) ---
# The base URL is the Open WebUI root plus /api. The API key comes from
# Open WebUI: Settings > Account > API keys.
# AI_PROVIDER=openaicompat
# AI_BASE_URL=https://openwebui.internal.example/api
# AI_CHAT_PATH=/chat/completions
# AI_API_KEY=sk-...
# AI_MODEL=qwen2.5:32b-instruct

# --- OpenAI ---
# AI_PROVIDER=openaicompat
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# --- Anthropic ---
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-20250514

AI_MAX_TOKENS=4096            # raise if reviews are truncated mid-batch
AI_TEMPERATURE=0.2            # low: scoring should be repeatable
AI_TIMEOUT=120s
AI_MAX_RETRIES=2
AI_BATCH_SIZE=8               # answers per call. Lower this for a small
                              # context window; raise it for better
                              # cross-answer contradiction detection.
AI_MAX_CONCURRENCY=2          # concurrent background review runs
