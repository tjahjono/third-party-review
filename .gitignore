# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Docker secrets: the real credential values docker-compose.yml mounts into
# the containers. Only secrets/README.md and the *.example placeholders are
# committed - see secrets/README.md.
/secrets/*.txt

# Sass toolchain for `make css`. The compiled stylesheet in
# web/static/css/ IS committed - the app needs no build step - but the
# node_modules that produce it are not.
node_modules/
package-lock.json
package.json

# Editor/IDE
# .idea/
# .vscode/
